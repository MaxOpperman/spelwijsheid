{
	"name": "spelwijsheid",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.18.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"preinstall": "node scripts/download-wordlist.js",
		"download:wordlist": "node scripts/download-wordlist.js",
		"download:geoip": "node --env-file-if-exists=.env scripts/download-geoip.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:style": "prettier --check . && eslint .",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "eslint . --fix",
		"test": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push"
	},
	"dependencies": {
		"drizzle-orm": "0.45.2",
		"maxmind": "5.0.7",
		"pg": "8.22.0",
		"ua-parser-js": "2.0.10"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.3",
		"@electric-sql/pglite-socket": "0.2.7",
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@fontsource/fira-mono": "5.3.0",
		"@neoconfetti/svelte": "2.2.2",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/leaflet": "1.9.22",
		"@types/node": "26.2.0",
		"@types/pg": "8.20.0",
		"drizzle-kit": "0.31.10",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.9.0",
		"husky": "9.1.7",
		"leaflet": "1.9.4",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.56.8",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vite": "8.2.1",
		"vite-plugin-static-copy": "4.1.1",
		"vitest": "4.1.10"
	}
}
